# Copy this file to .env and fill in your values.
# .env is gitignored — your secrets stay local.

# SQL Server SA password (used by sqlserver + servicebus-emulator containers)
SA_PASSWORD=YourStr0ngP@ssword!

# PostgreSQL password (used by pgvector container)
POSTGRES_PASSWORD=postgres

# OpenAI API key (required for embedding stage)
OPENAI_API_KEY=sk-your-key-here
