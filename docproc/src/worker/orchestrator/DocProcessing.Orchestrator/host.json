{
    "version": "2.0",
    "logging": {
        "applicationInsights": {
            "samplingSettings": {
                "isEnabled": true,
                "excludedTypes": "Request"
            },
            "enableLiveMetricsFilters": true
        }
    },
    "extensions": {
        "durableTask": {
            "hubName": "DocumentProcessingHub",
            "storageProvider": {
                "type": "AzureStorage"
            },
            "tracing": {
                "distributedTracingEnabled": true,
                "version": "None"
            }
        }
    }
}